# Copy this file to .env and fill in your values. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/alzikrayat
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign the JWT tokens. Use a long random value, and keep it private.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
# How long a token stays valid (examples: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d
